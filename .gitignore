# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rag-sociology — ingestion artifacts (PRD B.3 / Architecture ADR-1)
# Do NOT commit the source PDF (copyrighted coaching material) or vector stores
/chroma_db
/chroma_db/
.chroma
.chroma/
.chroma/**
/data/*.pdf
/data/*.PDF
*.pdf
!data/.gitkeep
!chroma_db/.gitkeep
!.chroma/.gitkeep

# explicit per deliverable (Security & Infra) — ensure coverage even if already matched above
.env
.env.local
chroma_db
.chroma
node_modules
.next
__pycache__/
__pycache__
venv/
venv
.venv/
.venv
*.pyc
*.pyo
.python-version

# eval reports (generated, contain answer text — not for git)
eval/results.json
eval/results.md
eval/*.results.json
